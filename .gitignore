# Secrets and local configuration
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Node / dashboard
node_modules/
dashboard/frontend/node_modules/

# Build and scratch output
.tmp/
tmp/
dist/
build/
*.log

# The read-only dashboard ships its prebuilt frontend with the plugin.
!dashboard/frontend/dist/
!dashboard/frontend/dist/**

# Generated novel-project state (must not be committed from fixture runs)
.story-system/
.webnovel/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Codex plugin source configuration is intentionally versioned:
#   AGENTS.md, .agents/, .codex-plugin/
# Project-scoped agents, managed hashes, pointers, and backups are local runtime state.
.codex/
